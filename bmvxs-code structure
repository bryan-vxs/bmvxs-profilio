<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bryan Mpiana — AI-Assisted Developer</title>
  <meta name="description" content="Bryan Mpiana, développeur Front-End & Intégrateur IA. Bilingue FR/EN. Ouvert aux opportunités au Canada." />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <style>
    /* ============ VARIABLES "NIVEAU DIEU" ============ */
    :root {
      --bg: #050505;
      --surface: rgba(18, 18, 18, 0.6);
      --surface-hover: rgba(28, 28, 28, 0.8);
      --text: #F5F5F0;
      --text-muted: #9A9A95;
      --border: rgba(255, 255, 255, 0.06);
      --border-strong: rgba(255, 255, 255, 0.15);
      --accent: #CCFF00;
      --accent-glow: rgba(204, 255, 0, 0.4);
      --accent-dim: rgba(204, 255, 0, 0.1);
      --font-display: 'Space Grotesk', system-ui, sans-serif;
      --font-body: 'Inter', system-ui, sans-serif;
      --ease: cubic-bezier(0.22, 1, 0.36, 1);
      --radius-lg: 24px;
      --radius-md: 16px;
      --radius-sm: 12px;
    }

    /* ============ RESET & BASE ============ */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; font-size: 17px; -webkit-text-size-adjust: 100%; }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-body);
      font-weight: 400;
      font-size: 1.05rem;
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
      position: relative;
    }

    /* ============ TEXTURE DE BRUIT (NOISE) PREMIUM ============ */
    body::after {
      content: "";
      position: fixed;
      top: 0; left: 0; width: 100vw; height: 100vh;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
      opacity: 0.04;
      pointer-events: none;
      z-index: 9999;
    }

    /* ============ BACKGROUND CANVAS ============ */
    #bg-canvas {
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      z-index: -1;
      pointer-events: none;
      opacity: 0.35;
    }

    /* ============ SPLASH ============ */
    .splash {
      position: fixed; inset: 0; z-index: 9998;
      background: var(--bg);
      display: flex; align-items: center; justify-content: center;
      padding: 24px;
      transition: opacity 0.9s var(--ease), visibility 0s linear 0.9s;
    }
    .splash.dismissed { opacity: 0; visibility: hidden; pointer-events: none; }
    .splash-content { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 36px; }
    .splash-mark {
      font-family: var(--font-display); font-size: clamp(6rem, 22vw, 14rem);
      font-weight: 700; line-height: 0.85; letter-spacing: -0.06em; color: var(--accent); display: flex; gap: 0.02em;
      text-shadow: 0 0 40px var(--accent-glow);
    }
    .splash-mark span { display: inline-block; opacity: 0; transform: translateY(50px); animation: splashLetter 0.8s var(--ease) forwards; }
    .splash-mark span:first-child { animation-delay: 0.15s; }
    .splash-mark span:last-child  { animation-delay: 0.3s; }
    .splash-caption { display: flex; flex-direction: column; gap: 14px; opacity: 0; transform: translateY(24px); animation: splashFadeUp 0.8s var(--ease) 0.8s forwards; }
    .splash-welcome { font-family: var(--font-display); font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.32em; color: var(--text-muted); }
    .splash-name { font-family: var(--font-display); font-size: clamp(2rem, 6vw, 3.4rem); font-weight: 700; letter-spacing: -0.035em; color: var(--text); line-height: 1.05; }
    .splash-role { font-family: var(--font-display); font-size: clamp(0.95rem, 1.4vw, 1.15rem); color: var(--accent); letter-spacing: 0.02em; }
    @keyframes splashLetter { to { opacity: 1; transform: translateY(0); } }
    @keyframes splashFadeUp { to { opacity: 1; transform: translateY(0); } }

    /* ============ CURSOR ============ */
    @media (hover: hover) and (pointer: fine) {
      body, a, button, input, textarea { cursor: none; }
      .cursor, .cursor-dot { position: fixed; top: 0; left: 0; pointer-events: none; z-index: 10000; border-radius: 50%; transform: translate(-50%, -50%); will-change: transform; }
      .cursor { width: 34px; height: 34px; border: 1px solid var(--accent); background: transparent; transition: width 0.3s var(--ease), height 0.3s var(--ease), background 0.3s, border-color 0.3s; box-shadow: 0 0 15px var(--accent-dim); }
      .cursor-dot { width: 5px; height: 5px; background: var(--accent); box-shadow: 0 0 8px var(--accent); }
      .cursor.is-hover { width: 68px; height: 68px; background: var(--accent-dim); border-color: var(--accent); box-shadow: 0 0 30px var(--accent-glow); }
    }
    @media (hover: none) { .cursor, .cursor-dot { display: none; } }

    /* ============ HEADER & MENU ============ */
    .header {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100; padding: 16px 0;
      backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
      background: rgba(5, 5, 5, 0.6); border-bottom: 1px solid var(--border); transition: border-color 0.3s;
    }
    .header-inner { max-width: 1400px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
    
    .header-left { display: flex; align-items: center; gap: 16px; }
    
    /* Menu Hamburger */
    .menu-toggle {
      display: flex; flex-direction: column; justify-content: space-around;
      width: 32px; height: 24px; background: transparent; border: none; z-index: 102;
    }
    .menu-toggle span {
      display: block; width: 100%; height: 2px; background: var(--text);
      border-radius: 2px; transition: transform 0.3s var(--ease), opacity 0.3s, background 0.3s;
    }
    .menu-toggle.active span:nth-child(1) { transform: translateY(8px) rotate(45deg); background: var(--accent); }
    .menu-toggle.active span:nth-child(2) { opacity: 0; }
    .menu-toggle.active span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); background: var(--accent); }

    /* Mobile Nav Overlay */
    .mobile-nav {
      position: fixed; inset: 0; background: rgba(5,5,5,0.95);
      backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
      z-index: 101; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 32px;
      opacity: 0; visibility: hidden; transition: all 0.4s var(--ease);
    }
    .mobile-nav.open { opacity: 1; visibility: visible; }
    .mobile-nav a {
      font-family: var(--font-display); font-size: 2rem; font-weight: 600; color: var(--text); text-decoration: none;
      transition: color 0.3s; transform: translateY(20px); opacity: 0;
    }
    .mobile-nav.open a { transform: translateY(0); opacity: 1; transition: all 0.4s var(--ease) 0.1s; }
    .mobile-nav.open a:nth-child(2) { transition-delay: 0.15s; }
    .mobile-nav.open a:nth-child(3) { transition-delay: 0.2s; }
    .mobile-nav.open a:nth-child(4) { transition-delay: 0.25s; }
    .mobile-nav a:hover { color: var(--accent); }

    .logo-group { display: flex; align-items: center; gap: 12px; text-decoration: none; }
    .logo-img { 
      width: 52px; height: 52px; border-radius: 50%; object-fit: cover; 
      border: 2px solid var(--accent); box-shadow: 0 0 15px var(--accent-glow);
      background: #000; padding: 2px; transition: transform 0.3s var(--ease);
    }
    .logo-group:hover .logo-img { transform: scale(1.05) rotate(5deg); }
    .logo { font-family: var(--font-display); font-weight: 700; font-size: 1.35rem; letter-spacing: -0.02em; color: var(--text); transition: color 0.2s; white-space: nowrap; }
    
    .nav { display: none; gap: 32px; align-items: center; }
    .nav a { color: var(--text-muted); text-decoration: none; font-size: 0.98rem; font-weight: 500; position: relative; transition: color 0.25s; }
    .nav a::after { content: ''; position: absolute; left: 0; bottom: -5px; width: 0; height: 2px; background: var(--accent); border-radius: 2px; transition: width 0.3s var(--ease); box-shadow: 0 0 10px var(--accent); }
    .nav a:hover { color: var(--text); }
    .nav a:hover::after { width: 100%; }
    
    @media (min-width: 860px) { 
      .nav { display: flex; } 
      .menu-toggle { display: none; }
      .header-left { gap: 0; }
    }

    /* ============ BUTTONS ============ */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      padding: 14px 28px; border-radius: 999px; font-family: var(--font-display); font-weight: 600; font-size: 0.95rem;
      text-decoration: none; border: 1px solid transparent; transition: all 0.3s var(--ease); white-space: nowrap;
    }
    .btn-primary { background: var(--accent); color: #050505; box-shadow: 0 0 20px var(--accent-glow); }
    .btn-primary:hover { background: #dbff33; box-shadow: 0 0 30px var(--accent-glow); transform: translateY(-2px); }
    .btn-outline { border-color: var(--border-strong); color: var(--text); background: transparent; }
    .btn-outline:hover { border-color: var(--accent); color: var(--accent); box-shadow: inset 0 0 15px var(--accent-dim); }
    .btn-ghost { color: var(--text-muted); background: transparent; padding: 14px 20px; }
    .btn-ghost:hover { color: var(--accent); text-shadow: 0 0 10px var(--accent); }

    /* ============ REVEAL & TEXT ============ */
    .reveal { opacity: 0; transform: translateY(30px); transition: opacity 0.8s var(--ease), transform 0.8s var(--ease); }
    .reveal.revealed { opacity: 1; transform: translateY(0); }
    .line { display: block; overflow: hidden; padding-bottom: 0.14em; margin-bottom: -0.14em; }
    .reveal-mask { display: inline-block; transform: translateY(110%); transition: transform 1s var(--ease); will-change: transform; }
    .reveal-mask.revealed { transform: translateY(0); }

    /* ============ HERO ============ */
    .hero { min-height: 100vh; display: flex; align-items: center; padding: 140px 24px 100px; max-width: 1400px; margin: 0 auto; position: relative; z-index: 1; }
    .hero-inner { max-width: 1150px; width: 100%; }
    .hero-eyebrow { font-family: var(--font-display); font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.28em; color: var(--accent); margin-bottom: 32px; font-weight: 500; display: flex; align-items: center; gap: 12px; text-shadow: 0 0 15px var(--accent-dim); }
    .hero-eyebrow img { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 2px solid var(--accent); box-shadow: 0 0 10px var(--accent-glow); }
    .hero-title { font-family: var(--font-display); font-size: clamp(3.2rem, 10vw, 8.8rem); font-weight: 700; line-height: 0.92; letter-spacing: -0.045em; margin-bottom: 36px; color: #FFFFFF; text-shadow: 0 10px 30px rgba(0,0,0,0.5); }
    .hero-title .accent { color: var(--accent); text-shadow: 0 0 40px var(--accent-dim); }
    .hero-sub { font-size: clamp(1.1rem, 1.5vw, 1.3rem); color: var(--text-muted); max-width: 680px; margin-bottom: 44px; line-height: 1.65; position: relative; }
    .hero-sub strong { color: var(--text); font-weight: 500; }
    .hero-cta { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 48px; }
    .hero-meta { list-style: none; display: flex; gap: 32px; flex-wrap: wrap; font-size: 0.95rem; color: var(--text-muted); font-family: var(--font-display); letter-spacing: 0.02em; }
    .hero-meta .dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; background: var(--accent); margin-right: 9px; box-shadow: 0 0 15px var(--accent); animation: pulse 2s infinite; vertical-align: middle; }
    @keyframes pulse { 0% { box-shadow: 0 0 0 0 var(--accent-glow); } 70% { box-shadow: 0 0 0 14px rgba(204, 255, 0, 0); } 100% { box-shadow: 0 0 0 0 rgba(204, 255, 0, 0); } }

    /* ============ SECTIONS & CARDS ============ */
    .section { max-width: 1400px; margin: 0 auto; padding: 120px 24px; border-top: 1px solid var(--border); position: relative; z-index: 1; }
    .section-head { display: flex; flex-direction: column; gap: 14px; margin-bottom: 56px; }
    @media (min-width: 720px) { .section-head { flex-direction: row; align-items: baseline; gap: 28px; } }
    .section-num { font-family: var(--font-display); font-size: 0.88rem; font-weight: 500; color: var(--accent); letter-spacing: 0.18em; text-transform: uppercase; white-space: nowrap; }
    .section-title { font-family: var(--font-display); font-size: clamp(2.2rem, 5vw, 3.8rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.05; }

    .grid-cards { display: grid; grid-template-columns: 1fr; gap: 24px; }
    @media (min-width: 820px) { .grid-cards { grid-template-columns: repeat(2, 1fr); } }

    .card {
      display: flex; flex-direction: column; text-decoration: none; color: inherit;
      background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg);
      overflow: hidden; transition: all 0.4s var(--ease); position: relative;
      backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    }
    .card::before {
      content: ''; position: absolute; inset: 0; border-radius: inherit; padding: 1px;
      background: linear-gradient(135deg, rgba(255,255,255,0.1), transparent 50%);
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor; mask-composite: exclude; pointer-events: none;
    }
    .card:hover { border-color: var(--border-strong); transform: translateY(-6px); box-shadow: 0 20px 40px rgba(0,0,0,0.5), 0 0 20px var(--accent-dim); }
    
    .card-media { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #111; }
    .card-media img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.3) brightness(0.8); transition: transform 0.7s var(--ease), filter 0.5s; }
    .card:hover .card-media img { transform: scale(1.05); filter: grayscale(0) brightness(1); }
    
    .card-info { padding: 24px; display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex: 1; }
    .card-info h3 { font-family: var(--font-display); font-size: 1.3rem; font-weight: 600; margin-bottom: 6px; }
    .card-info p { font-size: 0.95rem; color: var(--text-muted); line-height: 1.5; }
    .card-tag { font-family: var(--font-display); font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); padding: 6px 14px; border: 1px solid var(--accent-dim); border-radius: 999px; background: var(--accent-dim); flex-shrink: 0; text-shadow: 0 0 10px var(--accent-dim); }

    .card.featured { grid-column: span 1; }
    @media (min-width: 820px) { .card.featured { grid-column: span 2; } .card.featured .card-media { aspect-ratio: 21 / 9; } }

    /* ============ PREUVES / CLIENTS ============ */
    .proofs-grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
    @media(min-width: 720px) { .proofs-grid { grid-template-columns: 1fr 1fr; } }
    .proof-card {
      display: flex; align-items: center; justify-content: space-between; gap: 20px;
      padding: 24px 28px; background: var(--surface); border: 1px solid var(--border);
      border-radius: var(--radius-lg); text-decoration: none; color: var(--text);
      transition: all 0.3s; backdrop-filter: blur(10px);
    }
    .proof-card:hover { border-color: var(--accent); background: var(--surface-hover); transform: translateY(-4px); box-shadow: 0 10px 30px rgba(0,0,0,0.4); }
    .proof-info h4 { font-family: var(--font-display); font-size: 1.2rem; margin-bottom: 4px; }
    .proof-info p { font-size: 0.9rem; color: var(--text-muted); }
    .proof-link { color: var(--accent); font-size: 1.5rem; transition: transform 0.3s; }
    .proof-card:hover .proof-link { transform: translateX(5px); }

    /* ============ PROJETS EN COURS ============ */
    .ongoing-grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
    @media(min-width: 720px) { .ongoing-grid { grid-template-columns: 1fr 1fr; } }
    .ongoing-card { position: relative; border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--border); aspect-ratio: 16/9; background: #111; }
    .ongoing-card img { width: 100%; height: 100%; object-fit: cover; opacity: 0.7; transition: opacity 0.3s, transform 0.5s; cursor: zoom-in; }
    .ongoing-card:hover img { opacity: 1; transform: scale(1.03); }
    .ongoing-overlay {
      position: absolute; inset: 0; background: linear-gradient(to top, rgba(5,5,5,0.95) 0%, transparent 60%);
      display: flex; flex-direction: column; justify-content: flex-end; padding: 20px; pointer-events: none;
    }
    .ongoing-overlay h4 { font-family: var(--font-display); font-size: 1.15rem; margin-bottom: 4px; }
    .ongoing-overlay p { font-size: 0.85rem; color: var(--text-muted); }
    .ongoing-badge { position: absolute; top: 16px; right: 16px; background: var(--accent); color: #000; padding: 4px 12px; border-radius: 999px; font-family: var(--font-display); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; box-shadow: 0 0 15px var(--accent-glow); pointer-events: none; }

    /* ============ BENTO SKILLS (CORRIGÉ POUR LA SYMÉTRIE) ============ */
    .bento { display: grid; grid-template-columns: 1fr; gap: 16px; }
    @media (min-width: 720px) { .bento { grid-template-columns: repeat(3, 1fr); grid-auto-rows: minmax(200px, auto); } .bento-lg { grid-column: span 2; } .bento-wide { grid-column: span 3; } }
    
    .bento-item { 
      background: var(--surface); 
      border: 1px solid var(--border); 
      border-radius: var(--radius-lg); 
      padding: 28px; 
      display: flex; 
      flex-direction: column; 
      justify-content: flex-start; /* Aligne le contenu en haut */
      position: relative; 
      transition: all 0.3s; 
      backdrop-filter: blur(10px);
      min-height: 180px; /* Assure une hauteur minimale pour la symétrie */
      text-align: left;
    }
    
    .bento-item:hover { border-color: var(--accent-dim); background: var(--surface-hover); transform: translateY(-3px); box-shadow: 0 10px 30px rgba(0,0,0,0.3); }
    
    .bento-label { 
      position: static; /* Reprend sa place dans le flux pour un meilleur alignement */
      font-family: var(--font-display); 
      font-size: 0.75rem; 
      font-weight: 600; 
      text-transform: uppercase; 
      letter-spacing: 0.2em; 
      color: var(--text-muted);
      margin-bottom: auto; /* Pousse automatiquement le titre et la desc vers le bas */
    }
    
    .bento-item h3 { 
      font-family: var(--font-display); 
      font-size: 1.4rem; 
      font-weight: 600; 
      margin-bottom: 8px; 
      margin-top: 24px; /* Espace entre le label et le titre */
      line-height: 1.2;
      letter-spacing: -0.02em;
    }
    
    .bento-item p { font-size: 0.95rem; color: var(--text-muted); line-height: 1.5; }
    .bento-lg h3 { font-size: 1.7rem; }

    /* ============ À PROPOS ============ */
    .about-grid { display: grid; grid-template-columns: 1fr; gap: 48px; }
    @media (min-width: 900px) { .about-grid { grid-template-columns: 2fr 1fr; gap: 64px; } }
    .about-text p { color: var(--text-muted); font-size: 1.05rem; line-height: 1.8; margin-bottom: 20px; }
    .about-text .lead { color: var(--text); font-size: clamp(1.3rem, 2.2vw, 1.7rem); font-family: var(--font-display); font-weight: 500; line-height: 1.4; margin-bottom: 28px; }
    .about-aside { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; align-content: start; }
    .stat { border: 1px solid var(--border); border-radius: var(--radius-md); padding: 24px; background: var(--surface); backdrop-filter: blur(10px); transition: all 0.3s; }
    .stat:hover { border-color: var(--accent-dim); background: var(--surface-hover); }
    .stat-num { font-family: var(--font-display); font-size: 2.4rem; font-weight: 700; color: var(--accent); line-height: 1; margin-bottom: 4px; text-shadow: 0 0 20px var(--accent-dim); }
    .stat-label { font-size: 0.9rem; color: var(--text-muted); }

    /* ============ CONTACT ============ */
    .contact-lead { font-family: var(--font-display); font-size: clamp(1.3rem, 2.2vw, 1.7rem); font-weight: 500; line-height: 1.4; margin-bottom: 36px; max-width: 760px; }
    .contact-methods { display: grid; grid-template-columns: 1fr; gap: 16px; margin-bottom: 64px; }
    @media (min-width: 720px) { .contact-methods { grid-template-columns: 1fr 1fr; } }
    .contact-method { display: flex; align-items: center; gap: 20px; padding: 24px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); text-decoration: none; color: var(--text); transition: all 0.3s; backdrop-filter: blur(10px); }
    .contact-method:hover { border-color: var(--accent); background: var(--surface-hover); transform: translateY(-3px); box-shadow: 0 10px 30px rgba(0,0,0,0.4); }
    .contact-icon { width: 54px; height: 54px; border-radius: 16px; background: var(--accent-dim); color: var(--accent); display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: all 0.3s; }
    .contact-icon svg { width: 26px; height: 26px; }
    .contact-method:hover .contact-icon { background: var(--accent); color: #050505; transform: scale(1.08) rotate(-5deg); box-shadow: 0 0 20px var(--accent-glow); }
    .contact-method-text { display: flex; flex-direction: column; gap: 2px; flex: 1; }
    .contact-method-label { font-family: var(--font-display); font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.15em; color: var(--text-muted); }
    .contact-method-value { font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; color: var(--text); }

    .form-heading { font-family: var(--font-display); font-size: 1.4rem; font-weight: 600; margin-bottom: 24px; }
    .contact-form { display: flex; flex-direction: column; gap: 20px; max-width: 720px; }
