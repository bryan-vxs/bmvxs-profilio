  <button class="ai-toggle" id="aiToggle" aria-label="Ouvrir l'assistant">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
  </button>

  <div class="ai-chat" id="aiChat">
    <div class="ai-header">
      <img src="https://i.ibb.co/wTnpsxQ/file-000000007884820892bc091f0ed151c4.png" alt="Bryan" />
      <div class="ai-header-info">
        <h4>Assistant de Bryan</h4>
        <p>Disponible · FAQ</p>
      </div>
      <button class="ai-close" id="aiClose" aria-label="Fermer">&times;</button>
    </div>
    
    <div class="ai-messages" id="aiMessages">
      <div class="ai-message bot">
        <img src="https://i.ibb.co/wTnpsxQ/file-000000007884820892bc091f0ed151c4.png" alt="Bot" class="ai-avatar" />
        <div class="ai-bubble">Salut ! Je suis l'assistant de Bryan. Sélectionne une question ci-dessous pour découvrir son parcours, ses services ou ses projets !</div>
      </div>
    </div>

    <div class="ai-faq-area">
      <p class="faq-title">Choisis une question :</p>
      <div class="faq-grid" id="faqGrid"></div>
    </div>
  </div>

  <!-- LIGHTBOX POUR IMAGES EN GRAND -->
  <div class="lightbox" id="lightbox">
    <button class="lightbox-close" id="lightboxClose">&times;</button>
    <img src="" alt="Image agrandie" id="lightboxImg" />
  </div>

  <script>
    (function () {
      'use strict';

      /* ============================================
         1. MENU HAMBURGER (MOBILE)
         ============================================ */
      const menuToggle = document.getElementById('menuToggle');
      const mobileNav = document.getElementById('mobileNav');
      const navLinks = document.querySelectorAll('.nav-link');

      menuToggle.addEventListener('click', () => {
        menuToggle.classList.toggle('active');
        mobileNav.classList.toggle('open');
        document.body.style.overflow = mobileNav.classList.contains('open') ? 'hidden' : '';
      });

      navLinks.forEach(link => {
        link.addEventListener('click', () => {
          menuToggle.classList.remove('active');
          mobileNav.classList.remove('open');
          document.body.style.overflow = '';
        });
      });

      /* ============================================
         2. BACKGROUND ANIMATION (GLOBE + TEXTE)
         ============================================ */
      const canvas = document.getElementById('bg-canvas');
      const ctx = canvas.getContext('2d');
      let width, height;
      let particles = [];
      let textString = "BM by Bryan Mpiana";
      let textIndex = 0;
      let typingForward = true;
      let typingTimer = 0;

      function resize() {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
      }
      window.addEventListener('resize', resize);
      resize();

      class Node {
        constructor() {
          this.angle = Math.random() * Math.PI * 2;
          this.radius = Math.random() * (Math.min(width, height) * 0.35) + 50;
          this.speed = (Math.random() - 0.5) * 0.002;
          this.x = width / 2 + Math.cos(this.angle) * this.radius;
          this.y = height / 2 + Math.sin(this.angle) * this.radius;
        }
        update() {
          this.angle += this.speed;
          this.x = width / 2 + Math.cos(this.angle) * this.radius;
          this.y = height / 2 + Math.sin(this.angle) * this.radius;
        }
      }

      function initNodes() {
        particles = [];
        const count = window.innerWidth < 768 ? 30 : 70;
        for (let i = 0; i < count; i++) particles.push(new Node());
      }
      initNodes();

      function draw() {
        ctx.clearRect(0, 0, width, height);
        
        ctx.lineWidth = 0.5;
        for (let i = 0; i < particles.length; i++) {
          for (let j = i + 1; j < particles.length; j++) {
            const dx = particles[i].x - particles[j].x;
            const dy = particles[i].y - particles[j].y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 150) {
              ctx.beginPath();
              ctx.moveTo(particles[i].x, particles[i].y);
              ctx.lineTo(particles[j].x, particles[j].y);
              ctx.strokeStyle = `rgba(204, 255, 0, ${0.4 * (1 - dist / 150)})`;
              ctx.stroke();
            }
          }
        }

        particles.forEach(p => {
          p.update();
          ctx.beginPath();
          ctx.arc(p.x, p.y, 1.5, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(204, 255, 0, 0.5)';
          ctx.fill();
        });

        ctx.font = "bold 3rem 'Space Grotesk', sans-serif";
        ctx.fillStyle = "rgba(204, 255, 0, 0.08)";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        
        typingTimer++;
        if (typingTimer > 5) {
          if (typingForward) {
            textIndex++;
            if (textIndex >= textString.length) { typingForward = false; typingTimer = -100; }
          } else {
            textIndex--;
            if (textIndex <= 0) { typingForward = true; typingTimer = -100; }
          }
          typingTimer = 0;
        }
        
        const currentText = textString.substring(0, textIndex);
        ctx.fillText(currentText, width / 2, height / 2);

        requestAnimationFrame(draw);
      }
      draw();

      /* ============================================
         3. SPLASH SCREEN
         ============================================ */
      const splash = document.getElementById('splash');
      if (splash) {
        if (sessionStorage.getItem('bm_visited')) {
          splash.remove();
        } else {
          sessionStorage.setItem('bm_visited', '1');
          const dismiss = () => {
            if (splash.classList.contains('dismissed')) return;
            splash.classList.add('dismissed');
            setTimeout(() => splash.remove(), 1000);
          };
          splash.addEventListener('click', dismiss);
          setTimeout(dismiss, 2600);
        }
      }

      /* ============================================
         4. CUSTOM CURSOR & MAGNETIC
         ============================================ */
      const isFinePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      const cursor = document.querySelector('.cursor');
      const cursorDot = document.querySelector('.cursor-dot');

      if (isFinePointer && cursor && cursorDot) {
        let mouseX = 0, mouseY = 0, cursorX = 0, cursorY = 0;
        document.addEventListener('mousemove', (e) => {
          mouseX = e.clientX; mouseY = e.clientY;
          cursorDot.style.transform = `translate(${mouseX}px, ${mouseY}px) translate(-50%, -50%)`;
        });
        (function animateCursor() {
          cursorX += (mouseX - cursorX) * 0.16;
          cursorY += (mouseY - cursorY) * 0.16;
          cursor.style.transform = `translate(${cursorX}px, ${cursorY}px) translate(-50%, -50%)`;
          requestAnimationFrame(animateCursor);
        })();
        document.querySelectorAll('a, button, input, textarea, .card, .proof-card, .contact-method, .faq-btn, .ongoing-card img')
          .forEach((el) => {
            el.addEventListener('mouseenter', () => cursor.classList.add('is-hover'));
            el.addEventListener('mouseleave', () => cursor.classList.remove('is-hover'));
          });
      }

      const MAGNET = 0.2;
      document.querySelectorAll('.magnetic').forEach((el) => {
        el.addEventListener('mousemove', (e) => {
          const r = el.getBoundingClientRect();
          const x = e.clientX - r.left - r.width / 2;
          const y = e.clientY - r.top - r.height / 2;
          el.style.transform = `translate(${x * MAGNET}px, ${y * MAGNET}px)`;
        });
        el.addEventListener('mouseleave', () => { el.style.transform = ''; });
      });

      /* ============================================
         5. REVEAL ANIMATIONS
         ============================================ */
      const revealObs = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('revealed'); revealObs.unobserve(e.target); }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
      document.querySelectorAll('.reveal').forEach((el) => revealObs.observe(el));

      const maskObs = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('revealed'); maskObs.unobserve(e.target); }
        });
      }, { threshold: 0.1 });
      document.querySelectorAll('.reveal-mask').forEach((el) => maskObs.observe(el));

      /* ============================================
         6. CHAT WIDGET LOGIC (FAQ MODE)
         ============================================ */
      const aiToggle = document.getElementById('aiToggle');
      const aiChat = document.getElementById('aiChat');
      const aiClose = document.getElementById('aiClose');
      const aiMessages = document.getElementById('aiMessages');
      const faqGrid = document.getElementById('faqGrid');

      const faqData = [
        { q: "Qui est Bryan ?", a: "Bryan Mpiana a 19 ans. C'est un développeur autodidacte passionné d'IA. Il a appris à coder seul, sur des téléphones abîmés, sans ordinateur." },
        { q: "Quel est son parcours ?", a: "Il a dû arrêter ses études au niveau humanitaire par manque de fonds. Il a compensé par une mémoire et une capacité d'analyse hors du commun." },
        { q: "Quels sont ses services ?", a: "Création de sites vitrines, intégration Front-End (HTML/CSS/JS), intégration d'API et connexion avec des modèles d'IA (comme DeepSeek ou Gemini)." },
        { q: "Quels sont ses projets ?", a: "Bryan Digital (son 1er site), Kazadi Business et Emmanuel Silo. Il a aussi des projets en cours : un algorithme de trading et une app pour traders." },
        { q: "Ses compétences techniques ?", a: "Front-End : HTML, CSS, JS. Back-End/Cloud : Firebase, API REST. Langages : Python, JavaScript. Outils : Git, Copilot, DeepSeek." },
        { q: "Parle-t-il anglais ?", a: "Oui, il comprend et parle anglais. Il est bilingue FR/EN et s'adaptera très vite dans un pays anglophone comme le Canada." },
        { q: "Est-il disponible au Canada ?", a: "Oui ! Il est ouvert aux opportunités (freelance, stage ou poste junior) au Canada ou à distance." },
        { q: "Pourquoi le recruter ?", a: "Il possède une capacité d'apprentissage fulgurante, une passion pour l'IA et une détermination sans faille. Il livre vite et bien." },
        { q: "Comment le contacter ?", a: "Directement via WhatsApp (+243 854 958 927) ou par email (bryanmf141@gmail.com). Les boutons sont dans la section Contact !" },
        { q: "Quels sont ses tarifs ?", a: "Ses tarifs sont flexibles et s'adaptent au projet. Contactez-le directement pour obtenir un devis personnalisé." }
      ];

      faqData.forEach((item) => {
        const btn = document.createElement('button');
        btn.className = 'faq-btn';
        btn.textContent = item.q;
        btn.addEventListener('click', () => handleQuestionClick(item));
        faqGrid.appendChild(btn);
      });

      function handleQuestionClick(item) {
        addMessage(item.q, 'user');
        showTyping();
        setTimeout(() => {
          removeTyping();
          addMessage(item.a, 'bot');
        }, 600);
      }

      function addMessage(text, sender) {
        const msgDiv = document.createElement('div');
        msgDiv.className = `ai-message ${sender}`;
        let avatarHTML = sender === 'bot' ? `<img src="https://i.ibb.co/wTnpsxQ/file-000000007884820892bc091f0ed151c4.png" alt="Bot" class="ai-avatar" />` : '';
        msgDiv.innerHTML = `${avatarHTML}<div class="ai-bubble">${text}</div>`;
        aiMessages.appendChild(msgDiv);
        aiMessages.scrollTop = aiMessages.scrollHeight;
      }

      function showTyping() {
        const typingDiv = document.createElement('div');
        typingDiv.className = 'ai-message bot';
        typingDiv.id = 'typingIndicator';
        typingDiv.innerHTML = `
          <img src="https://i.ibb.co/wTnpsxQ/file-000000007884820892bc091f0ed151c4.png" alt="Bot" class="ai-avatar" />
          <div class="ai-bubble" style="display:flex;gap:4px;padding:14px 18px;">
            <span style="width:6px;height:6px;background:var(--text-muted);border-radius:50%;animation:typing 1.4s infinite ease-in-out both;animation-delay:-0.32s;"></span>
            <span style="width:6px;height:6px;background:var(--text-muted);border-radius:50%;animation:typing 1.4s infinite ease-in-out both;animation-delay:-0.16s;"></span>
            <span style="width:6px;height:6px;background:var(--text-muted);border-radius:50%;animation:typing 1.4s infinite ease-in-out both;"></span>
          </div>
        `;
        aiMessages.appendChild(typingDiv);
        aiMessages.scrollTop = aiMessages.scrollHeight;
      }

      function removeTyping() {
        const typing = document.getElementById('typingIndicator');
        if (typing) typing.remove();
      }

      aiToggle.addEventListener('click', () => aiChat.classList.toggle('open'));
      aiClose.addEventListener('click', () => aiChat.classList.remove('open'));

      /* ============================================
         7. FORMULAIRE CONTACT
         ============================================ */
      const form = document.getElementById('contactForm');
      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const d = new FormData(form);
          const name = (d.get('name') || '').toString().trim();
          const email = (d.get('email') || '').toString().trim();
          const message = (d.get('message') || '').toString().trim();
          if (!name || !email || !message) {
            alert('Merci de remplir tous les champs.');
            return;
          }
          const subject = encodeURIComponent(`Message portfolio — ${name}`);
          const body = encodeURIComponent(`Nom : ${name}\nE-mail : ${email}\n\n${message}\n\n---\nEnvoyé depuis le portfolio.`);
          window.location.href = `mailto:bryanmf141@gmail.com?subject=${subject}&body=${body}`;
          form.reset();
        });
      }

      /* ============================================
         8. HEADER SCROLL
         ============================================ */
      const header = document.querySelector('.header');
      window.addEventListener('scroll', () => {
        header.style.borderBottomColor = window.scrollY > 20 ? 'rgba(255,255,255,0.15)' : 'var(--border)';
      }, { passive: true });

      /* ============================================
         9. LIGHTBOX (ZOOM IMAGE)
         ============================================ */
      const lightbox = document.getElementById('lightbox');
      const lightboxImg = document.getElementById('lightboxImg');
      const lightboxClose = document.getElementById('lightboxClose');
      const ongoingImages = document.querySelectorAll('.ongoing-card img');

      ongoingImages.forEach(img => {
        img.addEventListener('click', () => {
          lightboxImg.src = img.src;
          lightbox.classList.add('open');
          document.body.style.overflow = 'hidden';
        });
      });

      function closeLightbox() {
        lightbox.classList.remove('open');
        document.body.style.overflow = '';
      }

      lightboxClose.addEventListener('click', closeLightbox);
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });

    })();
  </script>
</body>
</html>
