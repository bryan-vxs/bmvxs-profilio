<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>XAUUSD/BTC - Quantum Price Action V9 (M5 + Alarme)</title>
    <script src="https://unpkg.com/lightweight-charts@4.1.0/dist/lightweight-charts.standalone.production.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap');
        body { font-family: 'Share Tech Mono', monospace; background: #050505; color: #00ffcc; margin: 0; padding: 20px; background-image: radial-gradient(circle at 50% 50%, #0a1a1a 0%, #000000 100%); }
        .container { max-width: 1400px; margin: 0 auto; display: flex; gap: 20px; flex-wrap: wrap; }
        .main-chart { flex: 3; min-width: 300px; }
        .side-panel { flex: 1; min-width: 250px; background: #000; border: 1px solid #00ffcc; border-radius: 8px; padding: 15px; box-shadow: 0 0 20px rgba(0, 255, 204, 0.1); }
        .header { display: flex; justify-content: space-between; align-items: center; background: rgba(10, 20, 20, 0.8); padding: 15px; border-radius: 8px; margin-bottom: 15px; border: 1px solid #00ffcc; box-shadow: 0 0 15px rgba(0, 255, 204, 0.2); flex: 1 1 100%; }
        .live-price { font-size: 1.8em; font-weight: bold; color: #00ffcc; text-shadow: 0 0 10px #00ffcc; }
        .countdown-box { background: #111; padding: 8px 15px; border-radius: 6px; border-left: 3px solid #ff00ff; color: #ff00ff; text-shadow: 0 0 5px #ff00ff; }
        .psycho-info { background: rgba(10, 20, 20, 0.8); padding: 15px; border-radius: 8px; margin-bottom: 15px; font-size: 0.95em; display: flex; gap: 30px; flex-wrap: wrap; border-left: 4px solid #ffffff; color: #fff; text-shadow: 0 0 5px #fff; }
        .trade-info { background: rgba(10, 20, 20, 0.8); padding: 15px; border-radius: 8px; margin-bottom: 15px; border: 1px solid #ff00ff; display: flex; gap: 20px; flex-wrap: wrap; box-shadow: 0 0 15px rgba(255, 0, 255, 0.1); }
        .buy { color: #00ffcc; font-weight: bold; text-shadow: 0 0 10px #00ffcc; }
        .sell { color: #ff0055; font-weight: bold; text-shadow: 0 0 10px #ff0055; }
        #chart-container { width: 100%; height: 600px; background: #000; border-radius: 8px; border: 1px solid #00ffcc; box-shadow: 0 0 20px rgba(0, 255, 204, 0.1); }
        .status { color: #555; font-size: 0.85em; margin-top: 10px; text-align: center; }
        select { background: #000; color: #00ffcc; border: 1px solid #00ffcc; padding: 8px 15px; border-radius: 6px; font-weight: bold; cursor: pointer; font-family: inherit; outline: none; }
        select:hover { background: #00ffcc; color: #000; }
        h2 { margin: 0; color: #fff; text-shadow: 0 0 10px #fff; }
        .history-title { color: #ff00ff; border-bottom: 1px solid #ff00ff; padding-bottom: 5px; margin-bottom: 10px; font-size: 1.1em; text-shadow: 0 0 5px #ff00ff;}
        .history-item { margin-bottom: 8px; font-size: 0.85em; border-bottom: 1px dashed #333; padding-bottom: 5px; }
        .history-item.buy { color: #00ffcc; }
        .history-item.sell { color: #ff0055; }
        .indicator-box { display: flex; justify-content: space-between; margin-top: 10px; color: #fff; font-size: 0.9em; }
        .toggle-box { display: flex; align-items: center; gap: 10px; margin-top: 15px; color: #fff; font-size: 0.9em; }
        .toggle-box input[type="checkbox"] { appearance: none; width: 20px; height: 20px; background: #000; border: 1px solid #00ffcc; border-radius: 4px; cursor: pointer; position: relative; outline: none; }
        .toggle-box input[type="checkbox"]:checked { background: #00ffcc; box-shadow: 0 0 10px #00ffcc; }
        .toggle-box input[type="checkbox"]:checked::after { content: '✔'; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); color: #000; font-size: 14px; font-weight: bold; }
        
        /* Animation d'alarme */
        @keyframes flash { 0% { background-color: #050505; } 50% { background-color: #330000; } 100% { background-color: #050505; } }
        .alarm-active { animation: flash 0.5s 3; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div style="display: flex; align-items: center; gap: 15px;">
                <h2><span style="color:#ff00ff">QUANTUM V9 (M5)</span></h2>
                <select id="asset-selector" onchange="changeAsset()">
                    <option value="XAU/USD">XAU/USD (Or)</option>
                    <option value="BTC/USD">BTC/USD (Bitcoin)</option>
                </select>
            </div>
            <div class="live-price" id="live-price">--</div>
            <div class="countdown-box">SYNC: <span id="timer">--:--</span></div>
        </div>

        <div class="main-chart">
            <div class="psycho-info">
                <span>PIÈGE ACTIF: <b id="trap-zone">-</b></span>
                <span>LIQUIDATION HIGH: <b id="liq-high" style="color:#ff0055">-</b></span>
                <span>LIQUIDATION LOW: <b id="liq-low" style="color:#ff0055">-</b></span>
            </div>
            
            <div class="trade-info">
                <span>SIGNAL: <b id="signal">EN ATTENTE</b></span>
                <span>ENTRÉE: <b id="entry">-</b></span>
                <span>SL: <b id="sl">-</b></span>
                <span>TP: <b id="tp">-</b></span>
            </div>

            <div id="chart-container"></div>
            <div class="status" id="status">Initialisation du système Quantum V9...</div>
        </div>

        <div class="side-panel">
            <div class="history-title">CONTRÔLE ALGORITHME</div>
            <div class="toggle-box">
                <input type="checkbox" id="alarm-toggle" checked>
                <label for="alarm-toggle">Alarme Sonore Brutale</label>
            </div>
            
            <div class="history-title" style="margin-top: 20px;">HISTORIQUE DES VRAIES INTENTIONS</div>
            <div id="history-list">
                <div style="color:#555; font-size:0.8em;">En attente de signaux...</div>
            </div>
            
            <div class="history-title" style="margin-top: 20px;">INDICATEURS DE LIQUIDITÉ</div>
            <div class="indicator-box">
                <span>ATR (Volatilité):</span>
                <span id="atr-value" style="color:#00ffcc;">--</span>
            </div>
            <div class="indicator-box">
                <span>Force du Momentum:</span>
                <span id="momentum-value" style="color:#ff00ff;">--</span>
            </div>
        </div>
    </div>

    <script>
        const API_KEY = 'VOTRE_CLE_API_ICI';
        let SYMBOL = 'XAU/USD';
        // 🔥 PASSAGE EN M5 (5 minutes)
        const INTERVAL = '5min'; 
        const LIMIT = 500; // Plus de données pour le Price Action

        let chart = null;
        let candleSeries = null;
        let currentTrade = null;
        let timerInterval = null;
        let lastCandle = null;
        let ws = null;
        let linesArray = [];
        let activeTraps = [];

        // AUDIO CONTEXT POUR L'ALARME
        let audioCtx = null;

        function initChart() {
            const container = document.getElementById('chart-container');
            chart = LightweightCharts.createChart(container, {
                layout: { background: { color: '#050505' }, textColor: '#00ffcc' },
                grid: { vertLines: { color: '#111' }, horzLines: { color: '#111' } },
                timeScale: { timeVisible: true, secondsVisible: false },
            });
            candleSeries = chart.addCandlestickSeries({
                upColor: '#00ffcc', downColor: '#ff0055',
                borderUpColor: '#00ffcc', borderDownColor: '#ff0055',
                wickUpColor: '#00ffcc', wickDownColor: '#ff0055',
            });
        }

        // 🔔 FONCTION D'ALARME BRUTALE
        function playAlarm() {
            if (!document.getElementById('alarm-toggle').checked) return;
            
            // Secouer l'écran (visuel)
            document.body.classList.add('alarm-active');
            setTimeout(() => document.body.classList.remove('alarm-active'), 1500);

            // Son brutal
            try {
                if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const oscillator = audioCtx.createOscillator();
                const gainNode = audioCtx.createGain();
                
                oscillator.type = 'square';
                oscillator.frequency.setValueAtTime(880, audioCtx.currentTime);
                oscillator.frequency.setValueAtTime(440, audioCtx.currentTime + 0.1);
                oscillator.frequency.setValueAtTime(880, audioCtx.currentTime + 0.2);
                oscillator.frequency.setValueAtTime(440, audioCtx.currentTime + 0.3);
                
                gainNode.gain.setValueAtTime(0.5, audioCtx.currentTime);
                gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.5);
                
                oscillator.connect(gainNode);
                gainNode.connect(audioCtx.destination);
                oscillator.start();
                oscillator.stop(audioCtx.currentTime + 0.5);
            } catch (e) { console.log("Audio bloqué par le navigateur"); }
        }

        function parseDate(dateStr) {
            const parts = dateStr.split(' ');
            const d = parts[0].split('-');
            const t = parts[1] ? parts[1].split(':') : ['00','00','00'];
            const date = new Date(Date.UTC(parseInt(d[0]), parseInt(d[1])-1, parseInt(d[2]), parseInt(t[0]), parseInt(t[1]), parseInt(t[2])));
            return Math.floor(date.getTime() / 1000);
        }

        async function fetchData() {
            const url = `https://api.twelvedata.com/time_series?symbol=${SYMBOL}&interval=${INTERVAL}&outputsize=${LIMIT}&apikey=${API_KEY}`;
            try {
                const res = await fetch(url);
                const data = await res.json();
                if (data.status === 'error') throw new Error(data.message);
                if (!data.values) return null;

                return data.values.reverse().map(d => ({
                    time: parseDate(d.datetime),
                    open: parseFloat(d.open),
                    high: parseFloat(d.high),
                    low: parseFloat(d.low),
                    close: parseFloat(d.close)
                })).filter(d => !isNaN(d.open) && d.time);
            } catch (e) {
                document.getElementById('status').innerText = 'ERREUR SYSTÈME: ' + e.message;
                return null;
            }
        }

        function calculateATR(data, period = 14) {
            if (data.length < period + 1) return 0;
            let trSum = 0;
            for (let i = data.length - period; i < data.length; i++) {
                const high = data[i].high; const low = data[i].low; const prevClose = data[i-1].close;
                const tr = Math.max(high - low, Math.abs(high - prevClose), Math.abs(low - prevClose));
                trSum += tr;
            }
            return trSum / period;
        }

        // --- LOGIQUE PURE PRICE ACTION ---
        function runAlgorithm(data) {
            if (data.length < 100) return null;

            linesArray.forEach(line => chart.removeSeries(line));
            linesArray = [];

            const last = data[data.length - 1];
            const prev = data[data.length - 2];
            const atr = calculateATR(data);
            document.getElementById('atr-value').innerText = atr.toFixed(2);

            // 1. Calcul de la force brute (Momentum des 10 dernières bougies)
            const closePrice = last.close;
            const closePrice10 = data[data.length - 10].close;
            const momentum = ((closePrice - closePrice10) / closePrice10) * 100;
            document.getElementById('momentum-value').innerText = momentum.toFixed(2) + '%';

            // 2. Détection des Pièges (Mèches longues)
            const lookback = 50;
            const recent = data.slice(-lookback);
            
            for (let i = 2; i < recent.length - 2; i++) {
                const candle = recent[i];
                const body = Math.abs(candle.close - candle.open);
                const upperWick = candle.high - Math.max(candle.open, candle.close);
                const lowerWick = Math.min(candle.open, candle.close) - candle.low;
                
                // Mèche 2x plus grande que le corps = Piège
                if (upperWick > body * 2 && !activeTraps.some(t => Math.abs(t.val - candle.high) < 0.5)) {
                    activeTraps.push({ val: candle.high, type: 'high', time: candle.time });
                }
                if (lowerWick > body * 2 && !activeTraps.some(t => Math.abs(t.val - candle.low) < 0.5)) {
                    activeTraps.push({ val: candle.low, type: 'low', time: candle.time });
                }
            }

            // Nettoyage des vieux pièges
            activeTraps = activeTraps.filter(trap => {
                if (trap.type === 'high' && last.close > trap.val) return false;
                if (trap.type === 'low' && last.close < trap.val) return false;
                return true;
            }).slice(-5);

            // Dessin des pièges
            activeTraps.forEach(trap => {
                const whiteLine = chart.addLineSeries({ color: 'rgba(255, 255, 255, 0.8)', lineStyle: 2, lineWidth: 1, title: 'PIÈGE ' + trap.type.toUpperCase() });
                whiteLine.setData([{ time: trap.time, value: trap.val }, { time: last.time, value: trap.val }]);
                linesArray.push(whiteLine);
            });

            // 3. Niveaux de Liquidation (Plus haut / Plus bas des 60 dernières bougies)
            const recent60 = data.slice(-60);
            const high60 = Math.max(...recent60.map(d => d.high));
            const low60 = Math.min(...recent60.map(d => d.low));

            const redLineHigh = chart.addLineSeries({ color: '#ff0055', lineStyle: 0, lineWidth: 2, title: 'LIQUIDATION HIGH' });
            redLineHigh.setData([{ time: data[0].time, value: high60 }, { time: last.time, value: high60 }]);
            linesArray.push(redLineHigh);

            const redLineLow = chart.addLineSeries({ color: '#ff0055', lineStyle: 0, lineWidth: 2, title: 'LIQUIDATION LOW' });
            redLineLow.setData([{ time: data[0].time, value: low60 }, { time: last.time, value: low60 }]);
            linesArray.push(redLineLow);

            document.getElementById('trap-zone').innerText = `${activeTraps.length} PIÈGES ACTIFS`;
            document.getElementById('liq-high').innerText = high60.toFixed(2);
            document.getElementById('liq-low').innerText = low60.toFixed(2);

            // 4. GÉNÉRATION DE SIGNAUX CONSTANTS (Pure Price Action)
            let signal = null;
            
            // Condition d'entrée : Prix proche d'un piège + Bougie de rejet (Engulfing ou Pinbar)
            const nearestTrap = activeTraps.find(t => Math.abs(last.close - t.val) < (high60 - low60) * 0.05);

            if (nearestTrap) {
                // Signal BUY : Piège bas + Bougie haussière qui engloutit la précédente
                if (nearestTrap.type === 'low' && last.close > last.open && prev.close < prev.open) {
                    const entry = last.close;
                    const sl = nearestTrap.val * 0.999; // SL juste sous le piège
                    const risk = entry - sl;
                    if (risk > 0) {
                        signal = { type: 'BUY', entry, sl, tp: entry + (risk * 2), time: last.time }; // TP 1:2
                    }
                }
                // Signal SELL : Piège haut + Bougie baissière qui engloutit la précédente
                else if (nearestTrap.type === 'high' && last.close < last.open && prev.close > prev.open) {
                    const entry = last.close;
                    const sl = nearestTrap.val * 1.001; // SL juste au-dessus du piège
                    const risk = sl - entry;
                    if (risk > 0) {
                        signal = { type: 'SELL', entry, sl, tp: entry - (risk * 2), time: last.time }; // TP 1:2
                    }
                }
            }

            return signal;
        }

        function updateUI(signal) {
            const sigEl = document.getElementById('signal');
            if (signal) {
                if (!currentTrade || currentTrade.time !== signal.time) {
                    currentTrade = signal;
                    
                    // 🔔 DÉCLENCHEMENT DE L'ALARME
                    playAlarm();

                    const historyItem = document.createElement('div');
                    historyItem.className = `history-item ${signal.type === 'BUY' ? 'buy' : 'sell'}`;
                    historyItem.innerHTML = `[${new Date(signal.time * 1000).toLocaleTimeString()}] ${signal.type} - Entrée: ${signal.entry.toFixed(2)} | TP: ${signal.tp.toFixed(2)}`;
                    document.getElementById('history-list').prepend(historyItem);
                    
                    if (document.getElementById('history-list').children.length > 6) {
                        document.getElementById('history-list').lastChild.remove();
                    }
                }

                sigEl.innerText = signal.type;
                sigEl.className = signal.type === 'BUY' ? 'buy' : 'sell';
                document.getElementById('entry').innerText = signal.entry.toFixed(2);
                document.getElementById('sl').innerText = signal.sl.toFixed(2);
                document.getElementById('tp').innerText = signal.tp.toFixed(2);
                
                if (candleSeries) {
                    candleSeries.setMarkers([{
                        time: signal.time,
                        position: signal.type === 'BUY' ? 'belowBar' : 'aboveBar',
                        color: signal.type === 'BUY' ? '#00ffcc' : '#ff0055',
                        shape: signal.type === 'BUY' ? 'arrowUp' : 'arrowDown',
                        text: signal.type === 'BUY' ? '⬆️ BUY' : '⬇️ SELL'
                    }]);
                }
            } else {
                if (currentTrade) currentTrade = null;
                sigEl.innerText = 'SCAN EN COURS...';
                sigEl.className = '';
                document.getElementById('entry').innerText = '-';
                document.getElementById('sl').innerText = '-';
                document.getElementById('tp').innerText = '-';
                if (candleSeries) candleSeries.setMarkers([]);
            }
        }

        function connectWebSocket() {
            if (ws) ws.close();
            ws = new WebSocket(`wss://ws.twelvedata.com/v1/quotes/price?apikey=${API_KEY}`);
            ws.onopen = () => { ws.send(JSON.stringify({ "action": "subscribe", "params": { "symbols": SYMBOL } })); };
            ws.onmessage = (event) => {
                const data = JSON.parse(event.data);
                if (data.event === 'price' && data.symbol === SYMBOL) {
                    const price = parseFloat(data.price);
                    document.getElementById('live-price').innerText = price.toFixed(2);
                    updateLastCandle(price);
                }
            };
            ws.onclose = () => { setTimeout(connectWebSocket, 5000); };
        }

        function updateLastCandle(price) {
            if (!lastCandle) return;
            lastCandle.high = Math.max(lastCandle.high, price);
            lastCandle.low = Math.min(lastCandle.low, price);
            lastCandle.close = price;
            candleSeries.update(lastCandle);
        }

        function startTimer() {
            if (timerInterval) clearInterval(timerInterval);
            function tick() {
                const now = new Date();
                const minutesToNext = 5 - (now.getUTCMinutes() % 5); // Timer pour M5
                const totalSeconds = (minutesToNext * 60) - now.getUTCSeconds();
                const m = Math.floor(totalSeconds / 60);
                const s = totalSeconds % 60;
                document.getElementById('timer').innerText = `${m.toString().padStart(2,'0')}:${s.toString().padStart(2,'0')}`;
            }
            tick();
            timerInterval = setInterval(tick, 1000);
        }

        function changeAsset() {
            SYMBOL = document.getElementById('asset-selector').value;
            document.getElementById('status').innerText = `SYNC QUANTUM: Chargement de ${SYMBOL}...`;
            activeTraps = [];
            document.getElementById('history-list').innerHTML = '<div style="color:#555; font-size:0.8em;">En attente de signaux...</div>';
            if (ws) ws.close();
            main();
        }

        async function main() {
            if (!chart) initChart();
            const data = await fetchData();
            if (data && data.length > 0) {
                candleSeries.setData(data);
                lastCandle = data[data.length - 1];
                document.getElementById('status').innerText = `SYSTÈME OPÉRATIONNEL - ${SYMBOL} M5`;
                
                const signal = runAlgorithm(data);
                updateUI(signal);

                setInterval(async () => {
                    const newData = await fetchData();
                    if (newData && newData.length > 0) {
                        candleSeries.setData(newData);
                        lastCandle = newData[newData.length - 1];
                        const newSignal = runAlgorithm(newData);
                        updateUI(newSignal);
                    }
                }, 10000); // Scan toutes les 10 secondes
            }
            startTimer();
            connectWebSocket();
        }

        main();
    </script>
</body>
</html>
